# URL de conexión a PostgreSQL (Neon u otro Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secreto usado para firmar/verificar los JWT. Obligatorio: la API no arranca sin esto.
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Tiempo de expiración de los JWT (opcional, por defecto 8h)
JWT_EXPIRES_IN=8h

# Puerto donde escucha la API (opcional, por defecto 3000)
PORT=3000

# Deja esto en "false" en producción. En "true", TypeORM sincroniza el schema
# de la base de datos automáticamente a partir de las entidades (solo para dev).
DB_SYNCHRONIZE=false
