# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL en Render)
# En Render usa la "Internal Database URL"; desde tu PC, la "External Database URL" con DB_SSL=true
DATABASE_URL=postgresql://user:password@host/dbname
DB_SSL=false
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# CORS: URL(s) del frontend separadas por coma. Vacío = cualquier origen (solo desarrollo).
CORS_ORIGIN=http://localhost:4200
